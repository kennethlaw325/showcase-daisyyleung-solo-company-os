# Safe local defaults. Copy to .env.local and fill values printed by `npm run db:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_SERVICE_ROLE_KEY=
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-pro
OPENAI_API_KEY=
OPENAI_LUNA_MODEL=
OPENAI_TERRA_MODEL=
# Groq speech-to-text (server-only; leave empty until the live-provider gate is approved)
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback
PLATFORM_ADMIN_EMAILS=
APPLICATION_HASH_SALT=
SOLO_OS_DEMO_MODE=false
