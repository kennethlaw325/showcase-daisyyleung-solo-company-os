{
  "name": "solo-company-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:standalone": "node scripts/verify-standalone-mammoth.mjs",
    "check:app": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:start": "supabase start",
    "db:lint": "supabase db lint --local --schema public --level error --fail-on error",
    "db:test": "supabase test db --local",
    "check:db": "npm run db:lint && npm run db:test",
    "check": "npm run check:app && npm run check:db"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "mammoth": "1.12.1",
    "next": "16.3.0",
    "openai": "7.4.0",
    "pdf-parse": "2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.0",
    "jsdom": "^29.0.0",
    "supabase": "2.114.0",
    "typescript": "^5.9.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
